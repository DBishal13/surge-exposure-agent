# Copy to .env and fill in with your Lakebase instance details
# (Databricks workspace > Compute > Lakebase > your instance > Connection details).
LAKEBASE_HOST=your-lakebase-instance.database.cloud.databricks.com
LAKEBASE_PORT=5432
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_USER=your-user
LAKEBASE_PASSWORD=your-databricks-native-postgres-password
LAKEBASE_SSLMODE=require
